
#include <iostream>
using namespace std;

int n, a[20][20];  // Chessboard matrix

// Check whether queen can be placed safely
bool safe(int r, int c)
{
    // Check same column
    for(int i=0; i<r; i++)
        if(a[i][c]) return false;

    // Check left diagonal
    for(int i=r-1, j=c-1; i>=0 && j>=0; i--, j--)
        if(a[i][j]) return false;

    // Check right diagonal
    for(int i=r-1, j=c+1; i>=0 && j<n; i--, j++)
        if(a[i][j]) return false;

    return true;  // Position is safe
}

// Place remaining queens using backtracking
bool solve(int r)
{
    if(r == n) return true;  // All queens placed

    // Try each column in current row
    for(int c=0; c<n; c++)
    {
        if(safe(r,c))
        {
            a[r][c] = 1;  // Place queen

            if(solve(r+1))
                return true;

            a[r][c] = 0;  // Remove queen (Backtracking)
        }
    }
    return false;  // No safe position found
}

int main()
{
    cout << "Enter value of N: ";
    cin >> n;  // Input board size

    // Check valid board size
    if(n < 1 || n > 20)
    {
        cout << "Invalid N!";
        return 0;
    }

    int col;
    cout << "Enter first queen column (1 to " << n << "): ";
    cin >> col;  // Input first queen position

    // Check valid column
    if(col < 1 || col > n)
    {
        cout << "Invalid position!";
        return 0;
    }

    // Place first queen in first row
    a[0][col-1] = 1;

    // Start placing remaining queens from second row
    if(solve(1))
    {
        cout << "N-Queens Matrix:\n";

        // Display final chessboard
        for(int i=0; i<n; i++)
        {
            for(int j=0; j<n; j++)
                cout << a[i][j] << " ";
            cout << endl;
        }
    }
    else
        cout << "No solution exists";

    return 0;
}



























































































































































































































































































































































































































































































































































































































































































































The program takes the value of N from the user.



It creates an N × N matrix to represent the chessboard.



The user enters the column position of the first queen.



The program places the first queen in the first row at the selected column.



The solve() function starts placing the remaining queens from the second row.



The safe() function checks whether a position is safe.



It checks three conditions:
- No queen should be in the same column.
- No queen should be on the left diagonal.
- No queen should be on the right diagonal.



If the position is safe, the program places a queen (1) there.



Then it moves to the next row using recursion.



If no safe position is available, it goes back to the previous row.



It removes the previously placed queen and tries another position. This process is called Backtracking.



When all N queens are successfully placed, the function returns true.



Finally, the program displays the N-Queens matrix.



If no solution is found, it displays "No solution exists".