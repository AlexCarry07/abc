
#include <iostream>
using namespace std;

// Recursive function to calculate Fibonacci number
int fib(int n)
{
    if(n<=1) return n;  // Base condition
    return fib(n-1)+fib(n-2);  // Sum of previous two numbers
}

int main()
{
    int n;
    cout<<"Enter number of terms: ";
    cin>>n;  // Take input from user

    // Recursive Fibonacci series
    cout<<"Recursive: ";
    for(int i=0;i<n;i++)
        cout<<fib(i)<<" ";  // Print Fibonacci number

    // Variables for non-recursive method
    int a=0,b=1,c;
    cout<<"\nNon-Recursive: ";

    // Non-recursive Fibonacci using loop
    for(int i=0;i<n;i++)
    {
        cout<<a<<" ";  // Print current number
        c=a+b;         // Calculate next number
        a=b;           // Update first number
        b=c;           // Update second number
    }

    return 0;  // End program
}




















































































































































































































































































































































































































































































The program takes the number of terms (n) from the user.

Recursive method: The fib() function calls itself to calculate Fibonacci numbers. It stops when n <= 1.

Non-recursive method: Uses a for loop and three variables a, b, and c.

First, it prints a, then calculates c = a + b.

It updates a = b and b = c to calculate the next number.

Both methods print the Fibonacci series.
